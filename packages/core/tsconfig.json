{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["es2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "moduleDetection": "force",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,

    // Source imports name the file that is actually on disk — `./errors.ts`, not
    // `./errors.js`. tsc rewrites them to `.js` on emit, so `dist` is plain ESM while
    // the source stays runnable under node's own type stripping. One spelling, no lies.
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // `files` packs `dist`, never `src` — so a map whose `sources` names `../src/*.ts`
    // is a dead end on every consumer's machine: go-to-definition lands nowhere and a
    // stack trace resolves to a path that was never published. Inlining the sources
    // into the maps keeps both working without packing a second copy of the tree that
    // could drift from the one the maps point at. `test/guards/packaging.test.ts`
    // holds the property against the packed tarball.
    "inlineSources": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Mirrors the vitest alias, so the guards typecheck against the real source while
    // running against whatever tree `SMELT_GUARD_SRC` points at.
    "paths": {
      "@guard/*": ["./src/*.ts"]
    }
  },
  "include": ["src", "test", "vitest.config.ts"]
}
